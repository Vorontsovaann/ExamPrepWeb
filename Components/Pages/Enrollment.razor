@page "/enrollment/{CourseId:int}"
@using ExamPrepWeb.Models
@using ExamPrepWeb.Services
@using System.ComponentModel.DataAnnotations
@inject ICourseService CourseService
@inject NavigationManager Navigation

<PageTitle>Запись на курс</PageTitle>

<div class="container" style="max-width: 600px; padding-bottom: 4rem;">
    <h2 class="page-title" style="font-size: 2rem; margin-bottom: 2rem;">Запись на курс</h2>

    @if (_course == null)
    {
        <div class="alert alert-danger">❌ Курс не найден. <a href="/courses">Вернуться к списку</a></div>
    }
    else
    {
        <!-- Карточка с информацией о курсе -->
        <div class="card mb-4" style="background-color: #F0FDF4; border: 1px solid #D1FAE5;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h4 style="margin-bottom: 0.5rem; color: #065F46;">@_course.Title</h4>
                        <p class="text-muted mb-1">@_course.Subject</p>
                    </div>
                    <div style="font-weight: 700; font-size: 1.2rem; color: var(--accent-color);">
                        @_course.Price.ToString("N0") ₽
                    </div>
                </div>
                <hr style="margin: 10px 0; opacity: 0.5;">
                <div class="d-flex gap-4 text-sm" style="font-size: 0.95rem;">
                    <span>📅 Начало: <strong>@_course.StartDate.ToString("dd.MM.yyyy")</strong></span>
                    <span>👨‍🏫 <strong>@_course.TeacherName</strong></span>
                </div>
            </div>
        </div>

        <!-- Форма -->
        <div class="card">
            <div class="card-body">
                <EditForm Model="@_enrollmentForm" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="mb-3">
                        <label class="form-label">Ваше полное имя (ФИО) *</label>
                        <InputText @bind-Value="_enrollmentForm.FullName" 
                                   class="form-control" 
                                   placeholder="Иванов Иван Иванович" />
                        <ValidationMessage For="@(() => _enrollmentForm.FullName)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Номер телефона *</label>
                        <InputText @bind-Value="_enrollmentForm.Phone" 
                                   class="form-control" 
                                   placeholder="+7 (999) 000-00-00" />
                        <ValidationMessage For="@(() => _enrollmentForm.Phone)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email для связи *</label>
                        <InputText @bind-Value="_enrollmentForm.Email" 
                                   class="form-control" 
                                   placeholder="example@mail.ru" />
                        <ValidationMessage For="@(() => _enrollmentForm.Email)" class="text-danger" />
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success btn-lg" disabled="@_isSubmitting">
                            @(_isSubmitting ? "Отправка данных..." : "Записаться на курс")
                        </button>
                        <a href="/courses" class="btn btn-link text-muted text-center mt-2">
                            ← Вернуться к списку курсов
                        </a>
                    </div>
                </EditForm>

                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert @(_isSuccess ? "alert-success" : "alert-danger") mt-4">
                        @_message
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    
    private Course? _course;
    private string _message = "";
    private bool _isSuccess = false;
    private bool _isSubmitting = false;
    private EnrollmentForm _enrollmentForm = new();
    
    public class EnrollmentForm
    {
        [Required(ErrorMessage = "Введите ФИО")]
        [StringLength(100, MinimumLength = 5, ErrorMessage = "ФИО слишком короткое")]
        public string FullName { get; set; } = string.Empty;
        
        [Required(ErrorMessage = "Введите телефон")]
        [Phone(ErrorMessage = "Неверный формат телефона")]
        public string Phone { get; set; } = string.Empty;
        
        [Required(ErrorMessage = "Введите email")]
        [EmailAddress(ErrorMessage = "Неверный формат email")]
        public string Email { get; set; } = string.Empty;
    }
    
    protected override async Task OnInitializedAsync()
    {
        _course = await CourseService.GetCourseDetailsAsync(CourseId);
    }
    
    private async Task HandleValidSubmit()
    {
        _isSubmitting = true;
        StateHasChanged();
        
        try
        {
            // Имитация успешной записи для UI
            // В реальности здесь вызов сервиса
            await Task.Delay(1000); 
            
            _isSuccess = true;
            _message = $"✅ Спасибо, {_enrollmentForm.FullName}! Ваша заявка на курс \"{_course?.Title}\" принята. Мы свяжемся с вами по номеру {_enrollmentForm.Phone}.";
            _enrollmentForm = new EnrollmentForm();
        }
        catch (Exception ex)
        {
            _isSuccess = false;
            _message = $"❌ Ошибка: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }
}