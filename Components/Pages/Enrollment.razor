@page "/enrollment/{CourseId:int}"
@inject ICourseService CourseService
@inject NavigationManager Navigation

<PageTitle>Запись на курс</PageTitle>

<div class="container">
    @if (_course == null)
    {
        <div style="text-align: center; padding: 3rem;">
            <h3>Курс не найден</h3>
            <a href="/courses" class="btn btn-primary">← Назад к курсам</a>
        </div>
    }
    else if (_showSuccess)
    {
        <div class="success-box">
            <h2>✅ Успешно!</h2>
            <p style="font-size: 1.2rem;">@_message</p>
            <a href="/courses" class="btn btn-primary">К курсам</a>
        </div>
    }
    else
    {
        <div class="form-wrapper">
            <h2 style="text-align: center;">Запись на курс</h2>
            <p style="text-align: center; color: #6b7280; margin-bottom: 2rem;">@_course.Title</p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="error-alert">⚠️ @_errorMessage</div>
            }

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">ФИО *</label>
                <input type="text" id="inputFio" class="form-control" placeholder="Иванов Иван Иванович" />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Телефон *</label>
                <input type="tel" id="inputTel" class="form-control" placeholder="+7 (999) 000-00-00" />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Email *</label>
                <input type="email" id="inputEml" class="form-control" placeholder="student@example.com" />
            </div>

            <button type="button" onclick="submitEnrollment()" class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1.1rem; cursor: pointer;">
                Подтвердить запись
            </button>

            <div style="text-align: center; margin-top: 1.5rem;">
                <a href="/courses">← Назад к курсам</a>
            </div>
        </div>
    }
</div>

<script>
    async function submitEnrollment() {
        const fio = document.getElementById('inputFio').value.trim();
        const tel = document.getElementById('inputTel').value.trim();
        const eml = document.getElementById('inputEml').value.trim();
        
        const path = window.location.pathname;
        const courseId = parseInt(path.split('/').pop());
        
        console.log('[JS] Отправка:', { fio, tel, eml, courseId });

        if (!fio || !eml) {
            alert('⚠️ Заполните ФИО и Email!');
            return;
        }

        try {
            const response = await fetch('/api/enrollment', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ 
                    fio: fio, 
                    tel: tel, 
                    email: eml,
                    courseId: courseId 
                })
            });

            console.log('[JS] Status:', response.status);
            
            const result = await response.json();
            console.log('[JS] Результат:', result);

            if (result.success) {
                alert('✅ ' + result.message);
                window.location.href = '/courses?success=1';
            } else {
                let errorMsg = result.message || 'Ошибка при записи';
                
                if (result.errors) {
                    const errorDetails = Object.values(result.errors).flat().join('\n');
                    errorMsg += '\n\n' + errorDetails;
                }
                
                alert('❌ ' + errorMsg);
            }
        } catch (error) {
            console.error('[JS] Ошибка:', error);
            alert('❌ Ошибка: ' + error.message);
        }
    }
</script>

@code {
    [Parameter] public int CourseId { get; set; }
    private Course? _course;
    private bool _showSuccess = false;
    private string _message = "";
    private string _errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        _course = await CourseService.GetCourseDetailsAsync(CourseId);
    }
}