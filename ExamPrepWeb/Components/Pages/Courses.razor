@page "/courses"
@inject ICourseService CourseService
@inject NavigationManager Navigation

<PageTitle>Курсы - ExamPrepCourses</PageTitle>

<div class="container">
    @if (ShowSuccessMessage)
    {
        <div class="success-box" style="max-width: 600px; margin: 2rem auto; text-align: center;">
            <h2>✅ Успешно!</h2>
            <p>Вы успешно записаны на курс!</p>
        </div>
    }

    <h2 class="page-title">Доступные курсы</h2>

    @if (_courses == null) { <p style="text-align:center; padding:2rem;">Загрузка...</p> }
    else if (_courses.Count == 0) { <p style="text-align:center;">Курсов пока нет</p> }
    else
    {
        <div class="course-grid">
            @foreach (var c in _courses.OrderBy(x => x.Title))
            {
                <div class="course-card">
                    <h3>@c.Title</h3>
                    <p style="color:#6b7280;">@c.Subject</p>
                    <div class="course-price">@c.Price.ToString("N0") ₽</div>
                    <div class="course-meta">📅 @c.StartDate.ToString("dd.MM.yyyy") | 👨‍ @c.TeacherName</div>
                    <a href="/enrollment/@c.CourseId" class="btn btn-primary" style="display:block; margin-top:1rem;">Записаться →</a>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Course>? _courses;
    private bool ShowSuccessMessage => Navigation.Uri.Contains("success=1");
    protected override async Task OnInitializedAsync() => _courses = await CourseService.GetAvailableCoursesAsync();
}