# Этап 1: Сборка (Build)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Копируем только файл проекта для кэширования
COPY ["ExamPrepWeb.csproj", "./"]
RUN dotnet restore "ExamPrepWeb.csproj"

# Копируем все остальные файлы
COPY . .

# Компилируем
RUN dotnet build "ExamPrepWeb.csproj" -c Release -o /app/build

# Публикуем
RUN dotnet publish "ExamPrepWeb.csproj" -c Release -o /app/publish

# Этап 2: Запуск (Runtime)
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Копируем результат сборки из этапа 1
COPY --from=build /app/publish .

# Создаем папку для БД
RUN mkdir -p /app/Data

EXPOSE 8080

# Настройки окружения
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

# Запуск приложения
ENTRYPOINT ["dotnet", "ExamPrepWeb.dll"]