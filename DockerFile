# Этап 1: Сборка
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Копируем файл проекта
COPY ["ExamPrepWeb.csproj", "./"]
RUN dotnet restore "ExamPrepWeb.csproj"

# Копируем все остальные файлы
COPY . .

# Собираем и публикуем
RUN dotnet build "ExamPrepWeb.csproj" -c Release -o /app/build
RUN dotnet publish "ExamPrepWeb.csproj" -c Release -o /app/publish

# Этап 2: Запуск
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Создаем папку для базы данных
RUN mkdir -p /app/Data

# Копируем результат сборки
COPY --from=build /app/publish .

EXPOSE 8080

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

ENTRYPOINT ["dotnet", "ExamPrepWeb.dll"]